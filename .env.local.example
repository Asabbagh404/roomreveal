# RoomReveal server environment — copy to .env.local and fill in.
# FAL_KEY stays server-side only; it is read once in src/lib/env.ts (AR-CONFIG)
# and never exposed to the browser (AD-4).
FAL_KEY=

# Detection backend: "fal" (default) or "local" (self-hosted Grounded-SAM, see
# local-detect/README.md). The local URL is exposed to the browser (dev only).
NEXT_PUBLIC_DETECT_BACKEND=fal
NEXT_PUBLIC_LOCAL_DETECT_URL=http://localhost:8000/detect
